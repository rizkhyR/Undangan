<script>

/* =====================================================
   ELEMENT
===================================================== */

const tombol =
    document.getElementById("openButton");

const cover =
    document.getElementById("cover");

const ripple =
    document.getElementById("ripple");

const musik =
    document.getElementById("musik");

const musicButton =
    document.getElementById("musicButton");



/* =====================================================
   BUKA UNDANGAN
===================================================== */

tombol.addEventListener(
    "click",
    function(event) {


        const x =
            event.clientX;

        const y =
            event.clientY;


        ripple.style.left =
            x + "px";

        ripple.style.top =
            y + "px";


        ripple.classList.add(
            "aktif"
        );


        tombol.classList.add(
            "menghilang"
        );


        setTimeout(
            function() {

                cover.classList.add(
                    "hilang"
                );


                aktifkanScrollReveal();


                mulaiCountdown();


                mulaiMusik();

            },
            280
        );

    }
);



/* =====================================================
   ANIMASI SCROLL
===================================================== */

function aktifkanScrollReveal() {


    const elements =
        document.querySelectorAll(
            ".reveal"
        );


    const observer =
        new IntersectionObserver(

            function(entries) {


                entries.forEach(
                    function(entry) {


                        if (
                            entry.isIntersecting
                        ) {


                            entry.target
                                .classList
                                .add("show");


                            observer.unobserve(
                                entry.target
                            );

                        }

                    }
                );

            },


            {

                threshold: 0.12,

                rootMargin:
                    "0px 0px -45px 0px"

            }

        );


    elements.forEach(
        function(element) {

            observer.observe(
                element
            );

        }
    );

}



/* =====================================================
   COUNTDOWN
===================================================== */

function mulaiCountdown() {


    const target =
        new Date(
            "December 12, 2026 09:00:00"
        ).getTime();



    function updateCountdown() {


        const sekarang =
            new Date().getTime();


        const jarak =
            target - sekarang;


        if (jarak <= 0) {

            document.getElementById(
                "days"
            ).innerText = "00";

            document.getElementById(
                "hours"
            ).innerText = "00";

            document.getElementById(
                "minutes"
            ).innerText = "00";

            document.getElementById(
                "seconds"
            ).innerText = "00";

            return;

        }


        const hari =
            Math.floor(
                jarak /
                (1000 * 60 * 60 * 24)
            );


        const jam =
            Math.floor(
                (
                    jarak %
                    (1000 * 60 * 60 * 24)
                )
                /
                (1000 * 60 * 60)
            );


        const menit =
            Math.floor(
                (
                    jarak %
                    (1000 * 60 * 60)
                )
                /
                (1000 * 60)
            );


        const detik =
            Math.floor(
                (
                    jarak %
                    (1000 * 60)
                )
                /
                1000
            );


        document.getElementById(
            "days"
        ).innerText =
            String(hari)
                .padStart(2,"0");


        document.getElementById(
            "hours"
        ).innerText =
            String(jam)
                .padStart(2,"0");


        document.getElementById(
            "minutes"
        ).innerText =
            String(menit)
                .padStart(2,"0");


        document.getElementById(
            "seconds"
        ).innerText =
            String(detik)
                .padStart(2,"0");

    }


    updateCountdown();


    setInterval(
        updateCountdown,
        1000
    );

}



/* =====================================================
   MUSIK
===================================================== */

function mulaiMusik() {


    musik.volume = 0.35;


    const playPromise =
        musik.play();


    if (
        playPromise !== undefined
    ) {

        playPromise.catch(
            function() {

                musicButton.innerText =
                    "♪";

            }
        );

    }

}



musicButton.addEventListener(
    "click",
    function() {


        if (
            musik.paused
        ) {

            musik.play();

            musicButton.innerText =
                "♪";

        } else {

            musik.pause();

            musicButton.innerText =
                "🔇";

        }

    }
);



/* =====================================================
   COPY REKENING
===================================================== */

function copyRekening() {


    const nomor =
        document.getElementById(
            "nomorRekening"
        ).innerText;


    navigator.clipboard
        .writeText(nomor)

        .then(
            function() {


                document.getElementById(
                    "copyStatus"
                ).innerText =
                    "Nomor rekening berhasil disalin ✓";


                setTimeout(
                    function() {

                        document.getElementById(
                            "copyStatus"
                        ).innerText =
                            "";

                    },
                    2500
                );

            }
        )

        .catch(
            function() {

                document.getElementById(
                    "copyStatus"
                ).innerText =
                    "Gagal menyalin nomor rekening.";

            }
        );

}


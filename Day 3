<!DOCTYPE html>
<html lang="id">

<head>

<meta charset="UTF-8">

<meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
>

<title>Undangan Pernikahan</title>


<!-- =====================================================
     FONT
===================================================== -->

<link rel="preconnect"
      href="https://fonts.googleapis.com">

<link rel="preconnect"
      href="https://fonts.gstatic.com"
      crossorigin>

<link
href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;500;600&family=Montserrat:wght@300;400&display=swap"
rel="stylesheet">


<style>

/* =====================================================
   DASAR
===================================================== */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {

    width: 100%;
    min-height: 100%;

    overflow-x: hidden;

    background: #211316;

    font-family:
        "Montserrat",
        sans-serif;

    font-weight: 300;
}



/* =====================================================
   HALAMAN PERTAMA
===================================================== */

.cover {

    position: fixed;

    inset: 0;

    width: 100%;
    height: 100vh;
    height: 100svh;

    background: #3a2922;

    display: flex;

    justify-content: center;
    align-items: center;

    overflow: hidden;

    z-index: 100;
}


.cover-image {

    position: absolute;

    width: 100%;
    height: 100%;

    object-fit: contain;

    object-position: center;
}


.open-button {

    position: absolute;

    left: 50%;
    bottom: 7%;

    transform:
        translateX(-50%);

    padding:
        14px 30px;

    border:
        1px solid
        rgba(255,255,255,.85);

    border-radius: 40px;

    background:
        rgba(58,41,34,.90);

    color: white;

    font-family:
        "Montserrat",
        sans-serif;

    font-weight: 300;

    font-size: 10px;

    letter-spacing: 2px;

    cursor: pointer;

    z-index: 20;

    transition: .3s ease;
}


.open-button:hover {

    background: white;

    color: #6d2637;

    transform:
        translateX(-50%)
        translateY(-3px);
}



/* =====================================================
   TRANSISI CAHAYA MAROON
===================================================== */

.ripple-cahaya {

    position: fixed;

    width: 20px;
    height: 20px;

    left: 50%;
    top: 50%;

    transform:
        translate(-50%, -50%)
        scale(0);

    border-radius: 50%;

    background: #7b2334;

    box-shadow:

        0 0 20px #7b2334,

        0 0 50px #923448,

        0 0 100px #ad5365,

        0 0 180px #c47684;

    opacity: 0;

    pointer-events: none;

    z-index: 1000;
}


.ripple-cahaya.aktif {

    animation:
        cahayaMaroon
        .48s
        cubic-bezier(.12,.78,.2,1)
        forwards;
}


@keyframes cahayaMaroon {

    0% {

        transform:
            translate(-50%,-50%)
            scale(0);

        opacity: 1;
    }

    15% {

        transform:
            translate(-50%,-50%)
            scale(8);
    }

    35% {

        transform:
            translate(-50%,-50%)
            scale(25);
    }

    60% {

        transform:
            translate(-50%,-50%)
            scale(70);
    }

    100% {

        transform:
            translate(-50%,-50%)
            scale(170);
    }

}


.cover.hilang {

    opacity: 0;

    pointer-events: none;

    transition:
        opacity .12s ease;
}


.open-button.menghilang {
    opacity: 0;
}



/* =====================================================
   HALAMAN KEDUA
===================================================== */

.undangan {

    position: relative;

    width: 100%;

    min-height: 100vh;

    background: transparent;
}



/* =====================================================
   BACKGROUND FOTO
===================================================== */

.background-foto {

    position: fixed;

    inset: 0;

    width: 100%;
    height: 100%;

    background-image:
        url("./background.jpg");

    background-size: cover;

    background-position: center;

    z-index: 0;
}


/* Lapisan sangat tipis */

.background-overlay {

    position: fixed;

    inset: 0;

    background:
        rgba(35,12,18,.08);

    z-index: 1;

    pointer-events: none;
}



/* =====================================================
   MUSIK
===================================================== */

.music-button {

    position: fixed;

    right: 20px;
    top: 20px;

    width: 44px;
    height: 44px;

    border-radius: 50%;

    border:
        1px solid
        rgba(255,220,225,.45);

    background:
        rgba(70,20,34,.28);

    color: white;

    font-size: 19px;

    font-family:
        "Cormorant Garamond",
        serif;

    cursor: pointer;

    z-index: 20;

    backdrop-filter:
        blur(4px);

    transition: .3s ease;
}


.music-button:hover {

    transform:
        scale(1.08)
        rotate(10deg);
}



/* =====================================================
   KONTEN
===================================================== */

.konten {

    position: relative;

    z-index: 2;

    width: 100%;

    padding:
        80px 20px 100px;
}



/* =====================================================
   SECTION
===================================================== */

.section {

    width: 100%;

    max-width: 720px;

    margin:
        0 auto 125px;

    text-align: center;
}



/* =====================================================
   SEMUA ELEMEN TIDAK PUNYA TABLE
===================================================== */

.glass-card {

    width: 100%;

    max-width: 680px;

    margin: auto;

    padding:
        20px 10px;

    background: transparent;

    border: none;

    box-shadow: none;

    backdrop-filter: none;

    -webkit-backdrop-filter: none;

    color: white;

    text-align: center;
}



/* =====================================================
   TEKS PEMBUKA
===================================================== */

.label {

    font-family:
        "Montserrat",
        sans-serif;

    font-weight: 300;

    font-size: 8px;

    letter-spacing: 5px;

    color:
        rgba(255,235,238,.85);

    margin-bottom: 20px;
}


.nama {

    font-family:
        "Cormorant Garamond",
        Georgia,
        serif;

    font-weight: 300;

    font-size:
        clamp(48px,9vw,78px);

    letter-spacing: 1px;

    line-height: .9;

    color:
        rgba(255,250,250,.98);

    text-shadow:
        0 4px 25px
        rgba(0,0,0,.35);
}


.nama span {

    display: block;

    font-size: .55em;

    color:
        #e2a0ac;

    margin:
        7px 0;
}


.tanggal {

    font-family:
        "Montserrat",
        sans-serif;

    font-size: 10px;

    font-weight: 300;

    letter-spacing: 5px;

    color:
        rgba(255,225,230,.9);

    text-shadow:
        0 2px 12px
        rgba(0,0,0,.4);
}



/* =====================================================
   ORNAMEN
===================================================== */

.ornamen {

    display: flex;

    justify-content: center;

    align-items: center;

    gap: 12px;

    margin:
        24px 0;
}


.ornamen span {

    width: 55px;

    height: 1px;

    background:
        rgba(240,190,198,.55);

    box-shadow:
        0 0 8px
        rgba(220,120,140,.25);
}


.ornamen i {

    font-family:
        "Cormorant Garamond",
        serif;

    font-size: 18px;

    font-style: normal;

    color:
        #df8f9d;
}



/* =====================================================
   KATA-KATA
===================================================== */

.quote {

    max-width: 560px;

    margin:
        auto;

    font-family:
        "Cormorant Garamond",
        Georgia,
        serif;

    font-size:
        clamp(21px,4.5vw,29px);

    font-style: italic;

    font-weight: 300;

    line-height: 1.55;

    color:
        rgba(255,248,249,.96);

    text-shadow:
        0 3px 18px
        rgba(0,0,0,.45);
}


.quote-small {

    max-width: 520px;

    margin:
        auto;

    font-family:
        "Cormorant Garamond",
        Georgia,
        serif;

    font-size: 18px;

    font-weight: 300;

    line-height: 1.7;

    color:
        rgba(255,235,238,.88);

    text-shadow:
        0 2px 14px
        rgba(0,0,0,.4);
}



/* =====================================================
   FOTO UTAMA MELAYANG
===================================================== */

.foto-box {

    width: 82%;

    max-width: 520px;

    margin:
        auto;

    overflow: hidden;

    border-radius: 18px;

    border:
        1px solid
        rgba(255,220,225,.35);

    box-shadow:
        0 20px 50px
        rgba(0,0,0,.35);

    transform:
        translateY(0);

    transition:
        transform 1s ease;
}


.foto-box:hover {

    transform:
        translateY(-7px);
}


.foto-box img {

    width: 100%;

    display: block;

    max-height: 600px;

    object-fit: cover;
}


.foto-caption {

    margin-top: 18px;

    font-family:
        "Montserrat",
        sans-serif;

    font-size: 8px;

    letter-spacing: 5px;

    color:
        rgba(255,220,225,.82);

    text-shadow:
        0 2px 12px
        rgba(0,0,0,.5);
}



/* =====================================================
   MEMPELAI
===================================================== */

.mempelai {

    display: grid;

    grid-template-columns:
        1fr auto 1fr;

    align-items: center;

    gap: 25px;

    max-width: 650px;

    margin:
        auto;
}


.foto-kecil {

    width: 155px;

    height: 155px;

    margin:
        auto auto 18px;

    border-radius: 50%;

    overflow: hidden;

    border:
        1px solid
        rgba(255,220,225,.4);

    box-shadow:
        0 15px 40px
        rgba(0,0,0,.35);
}


.foto-kecil img {

    width: 100%;

    height: 100%;

    object-fit: cover;
}


.mempelai-item h2 {

    font-family:
        "Cormorant Garamond",
        Georgia,
        serif;

    font-size: 31px;

    font-weight: 300;

    color: white;

    text-shadow:
        0 3px 15px
        rgba(0,0,0,.45);

    margin-bottom: 8px;
}


.mempelai-item p {

    font-family:
        "Cormorant Garamond",
        Georgia,
        serif;

    font-size: 16px;

    line-height: 1.5;

    color:
        rgba(255,235,238,.88);

    text-shadow:
        0 2px 12px
        rgba(0,0,0,.4);
}


.ampersand {

    font-family:
        "Cormorant Garamond",
        serif;

    font-size: 45px;

    font-weight: 300;

    color:
        #dfa0ac;

    text-shadow:
        0 3px 15px
        rgba(0,0,0,.4);
}



/* =====================================================
   COUNTDOWN
===================================================== */

.countdown-card h2,
.calendar-card h2,
.acara h2,
.lokasi-card h2,
.gallery-card h2,
.rekening-card h2,
.ucapan-card h2 {

    font-family:
        "Cormorant Garamond",
        Georgia,
        serif;

    font-size:
        clamp(35px,7vw,48px);

    font-weight: 300;

    color: white;

    text-shadow:
        0 3px 18px
        rgba(0,0,0,.45);

    margin-bottom: 28px;
}


.countdown {

    display: flex;

    justify-content: center;

    gap: 15px;

    max-width: 600px;

    margin:
        auto;
}


.count-box {

    min-width: 80px;

    padding:
        8px 5px;

    background:
        transparent;

    border: none;
}


.count-box span {

    display: block;

    font-family:
        "Cormorant Garamond",
        serif;

    font-size: 38px;

    font-weight: 300;

    color: white;

    text-shadow:
        0 3px 15px
        rgba(0,0,0,.5);
}


.count-box small {

    font-family:
        "Montserrat",
        sans-serif;

    font-size: 7px;

    letter-spacing: 2px;

    color:
        rgba(255,225,230,.85);
}



/* =====================================================
   CALENDAR
===================================================== */

.calendar {

    max-width: 440px;

    margin:
        auto;

    padding:
        5px;
}


.calendar-head {

    display: grid;

    grid-template-columns:
        repeat(7,1fr);

    margin-bottom: 10px;

    font-family:
        "Montserrat",
        sans-serif;

    font-size: 7px;

    letter-spacing: 1px;

    color:
        rgba(255,205,215,.85);
}


.calendar-grid {

    display: grid;

    grid-template-columns:
        repeat(7,1fr);

    gap: 4px;
}


.calendar-grid span {

    aspect-ratio: 1;

    display: flex;

    align-items: center;

    justify-content: center;

    border-radius: 50%;

    font-family:
        "Montserrat",
        sans-serif;

    font-size: 11px;

    color:
        rgba(255,240,242,.9);

    text-shadow:
        0 2px 10px
        rgba(0,0,0,.5);
}


.calendar-grid
.special-date {

    background:
        rgba(135,40,60,.65);

    box-shadow:
        0 0 22px
        rgba(180,70,90,.45);

    color: white;
}



/* =====================================================
   ACARA
===================================================== */

.detail {

    display: flex;

    justify-content: center;

    gap: 50px;

    max-width: 650px;

    margin:
        auto;
}


.detail-box {

    flex: 1;

    padding:
        5px;

    background: transparent;

    border: none;
}


.detail-box span {

    display: block;

    font-size: 20px;

    color:
        #df8f9e;

    margin-bottom: 12px;

    text-shadow:
        0 3px 15px
        rgba(0,0,0,.5);
}


.detail-box h3 {

    font-family:
        "Cormorant Garamond",
        serif;

    font-size: 28px;

    font-weight: 300;

    color: white;

    margin-bottom: 10px;

    text-shadow:
        0 3px 15px
        rgba(0,0,0,.45);
}


.detail-box p {

    font-family:
        "Cormorant Garamond",
        serif;

    font-size: 16px;

    line-height: 1.6;

    color:
        rgba(255,235,238,.88);

    text-shadow:
        0 2px 12px
        rgba(0,0,0,.45);
}



/* =====================================================
   LOKASI
===================================================== */

.lokasi-icon {

    font-family:
        "Cormorant Garamond",
        serif;

    font-size: 38px;

    color:
        #df8f9e;

    margin-bottom: 10px;

    text-shadow:
        0 3px 15px
        rgba(0,0,0,.5);
}


.lokasi-card h3 {

    font-family:
        "Cormorant Garamond",
        serif;

    font-size: 28px;

    font-weight: 300;

    color: white;

    margin-bottom: 8px;
}


.lokasi-card > p {

    font-family:
        "Cormorant Garamond",
        serif;

    font-size: 17px;

    line-height: 1.6;

    color:
        rgba(255,235,238,.88);

    margin-bottom: 22px;
}


.maps-button {

    display: inline-block;

    padding:
        10px 22px;

    border:
        1px solid
        rgba(255,220,225,.55);

    border-radius: 30px;

    background:
        rgba(85,20,35,.28);

    color: white;

    font-family:
        "Montserrat",
        sans-serif;

    font-size: 8px;

    letter-spacing: 2px;

    text-decoration: none;

    backdrop-filter:
        blur(4px);

    transition: .3s ease;
}


.maps-button:hover {

    background:
        rgba(255,255,255,.85);

    color:
        #702538;
}



/* =====================================================
   GALERI
===================================================== */

.gallery {

    display: flex;

    gap: 15px;

    overflow-x: auto;

    scroll-snap-type: x mandatory;

    scrollbar-width: none;

    padding:
        5px 5px 15px;
}


.gallery::-webkit-scrollbar {
    display: none;
}


.gallery-item {

    flex:
        0 0 70%;

    scroll-snap-align: center;

    overflow: hidden;

    border-radius: 17px;

    border:
        1px solid
        rgba(255,220,225,.35);

    box-shadow:
        0 18px 40px
        rgba(0,0,0,.35);
}


.gallery-item img {

    width: 100%;

    height: 400px;

    object-fit: cover;

    display: block;

    transition:
        transform .8s ease;
}


.gallery-item:hover img {

    transform:
        scale(1.04);
}


.swipe-text {

    margin-top: 12px;

    font-family:
        "Montserrat",
        sans-serif;

    font-size: 8px;

    letter-spacing: 1px;

    color:
        rgba(255,225,230,.7);
}



/* =====================================================
   REKENING
===================================================== */

.rekening-text {

    max-width: 550px;

    margin:
        auto auto 25px;

    font-family:
        "Cormorant Garamond",
        serif;

    font-size: 18px;

    line-height: 1.65;

    color:
        rgba(255,235,238,.9);

    text-shadow:
        0 2px 12px
        rgba(0,0,0,.45);
}


.rekening-box {

    max-width: 400px;

    margin:
        auto;

    padding:
        20px;

    border-top:
        1px solid
        rgba(255,220,225,.3);

    border-bottom:
        1px solid
        rgba(255,220,225,.3);
}


.bank-logo {

    font-family:
        "Montserrat",
        sans-serif;

    font-size: 10px;

    letter-spacing: 4px;

    color:
        #efb3bd;

    margin-bottom: 12px;
}


.rekening-box h3 {

    font-family:
        "Cormorant Garamond",
        serif;

    font-size: 27px;

    font-weight: 300;

    margin-bottom: 10px;
}


.nomor-rekening {

    font-family:
        "Montserrat",
        sans-serif;

    font-size: 19px;

    letter-spacing: 2px;

    margin-bottom: 7px;
}


.rekening-box > p {

    font-family:
        "Cormorant Garamond",
        serif;

    font-size: 15px;

    color:
        rgba(255,235,238,.8);

    margin-bottom: 18px;
}


.copy-button {

    padding:
        10px 18px;

    border:
        1px solid
        rgba(255,220,225,.5);

    border-radius: 30px;

    background:
        rgba(80,20,35,.25);

    color: white;

    font-family:
        "Montserrat",
        sans-serif;

    font-size: 8px;

    letter-spacing: 1.5px;

    cursor: pointer;

    backdrop-filter:
        blur(4px);
}


.copy-button:hover {

    background: white;

    color: #702538;
}


.copy-status {

    margin-top: 12px;

    min-height: 18px;

    font-family:
        "Cormorant Garamond",
        serif;

    font-size: 14px;

    color:
        #efb1bc;
}



/* =====================================================
   UCAPAN
===================================================== */

.ucapan-card > p:not(.label) {

    max-width: 500px;

    margin:
        auto auto 22px;

    font-family:
        "Cormorant Garamond",
        serif;

    font-size: 18px;

    line-height: 1.6;

    color:
        rgba(255,235,238,.9);

    text-shadow:
        0 2px 12px
        rgba(0,0,0,.45);
}



/* =====================================================
   PENUTUP
===================================================== */

.penutup h2 {

    font-size:
        clamp(40px,8vw,58px);

    margin-bottom: 15px;
}


.penutup > p {

    font-family:
        "Cormorant Garamond",
        serif;

    font-size: 18px;

    line-height: 1.7;

    color:
        rgba(255,235,238,.9);

    text-shadow:
        0 2px 14px
        rgba(0,0,0,.5);
}


.penutup h3 {

    font-family:
        "Cormorant Garamond",
        serif;

    font-size: 30px;

    font-weight: 300;

    color:
        #efb7c0;

    text-shadow:
        0 3px 15px
        rgba(0,0,0,.5);
}



/* =====================================================
   ANIMASI SAAT SCROLL
===================================================== */

.reveal {

    opacity: 0;

    transform:
        translateY(80px)
        scale(.97);

    filter:
        blur(8px);

    transition:

        opacity 1.2s
        cubic-bezier(.2,.7,.2,1),

        transform 1.2s
        cubic-bezier(.2,.7,.2,1),

        filter 1.2s ease;
}


.reveal.show {

    opacity: 1;

    transform:
        translateY(0)
        scale(1);

    filter:
        blur(0);
}



/* =====================================================
   MOBILE
===================================================== */

@media (max-width: 700px) {


    .konten {

        padding:
            55px 15px 80px;
    }


    .section {

        margin-bottom: 95px;
    }


    .glass-card {

        padding:
            10px 5px;
    }


    .mempelai {

        grid-template-columns:
            1fr;

        gap: 18px;
    }


    .ampersand {

        margin:
            -5px 0;
    }


    .foto-kecil {

        width: 135px;
        height: 135px;
    }


    .detail {

        flex-direction: column;

        gap: 35px;
    }


    .countdown {

        gap: 5px;
    }


    .count-box {

        min-width: 65px;
    }


    .count-box span {

        font-size: 29px;
    }


    .gallery-item {

        flex-basis: 82%;
    }


    .gallery-item img {

        height: 350px;
    }


    .music-button {

        width: 40px;
        height: 40px;

        top: 14px;
        right: 14px;
    }

}

</style>

</head>



<body>


<!-- =====================================================
     COVER
===================================================== -->

<section
    class="cover"
    id="cover"
>

    <img
        src="./Pre.png"
        alt="Undangan Pernikahan"
        class="cover-image"
    >


    <button
        class="open-button"
        id="openButton"
    >
        BUKA UNDANGAN
    </button>

</section>



<!-- =====================================================
     TRANSISI
===================================================== -->

<div
    class="ripple-cahaya"
    id="ripple"
></div>



<!-- =====================================================
     HALAMAN KEDUA
===================================================== -->

<main class="undangan">


    <div class="background-foto"></div>

    <div class="background-overlay"></div>



    <!-- MUSIK -->

    <button
        class="music-button"
        id="musicButton"
    >
        ♪
    </button>


    <audio
        id="musik"
        loop
    >

        <source
            src="./musik.mp3"
            type="audio/mpeg"
        >

    </audio>



    <!-- =================================================
         KONTEN
    ================================================== -->

    <div class="konten">



        <!-- 1. OPENING -->

        <section class="section reveal">

            <div class="glass-card">

                <p class="label">
                    THE WEDDING OF

    <script>
      /* =====================================================
   BUKA UNDANGAN
===================================================== */

function openInvitation() {

    const cover =
        document.getElementById("cover");

    const envelope =
        document.getElementById("envelope");

    const invitation =
        document.getElementById("invitation");

    envelope.classList.add("open");

    setTimeout(function () {

        cover.classList.add("hide");

        invitation.classList.add("show");

        startReveal();

        startMusic();

    }, 900);

}


/* =====================================================
   MUSIK
===================================================== */

const music =
    document.getElementById("weddingMusic");

const musicButton =
    document.getElementById("music-button");

function startMusic() {

    music.volume = 0.35;

    music.play()
        .then(function () {

            musicButton.innerHTML = "♫";

        })
        .catch(function () {

            musicButton.innerHTML = "♪";

        });

}


function toggleMusic() {

    if (music.paused) {

        music.play();

        musicButton.innerHTML = "♫";

    } else {

        music.pause();

        musicButton.innerHTML = "♪";

    }

}


/* =====================================================
   COUNTDOWN
===================================================== */

const weddingDate =
    new Date("May 31, 2026 14:00:00").getTime();


function updateCountdown() {

    const now =
        new Date().getTime();

    const distance =
        weddingDate - now;


    if (distance <= 0) {

        document.getElementById("days").innerText = "0";
        document.getElementById("hours").innerText = "0";
        document.getElementById("minutes").innerText = "0";
        document.getElementById("seconds").innerText = "0";

        return;
    }


    const days =
        Math.floor(
            distance /
            (1000 * 60 * 60 * 24)
        );

    const hours =
        Math.floor(
            (distance %
                (1000 * 60 * 60 * 24))
            /
            (1000 * 60 * 60)
        );

    const minutes =
        Math.floor(
            (distance %
                (1000 * 60 * 60))
            /
            (1000 * 60)
        );

    const seconds =
        Math.floor(
            (distance %
                (1000 * 60))
            /
            1000
        );


    document.getElementById("days")
        .innerText = days;

    document.getElementById("hours")
        .innerText = hours;

    document.getElementById("minutes")
        .innerText = minutes;

    document.getElementById("seconds")
        .innerText = seconds;

}


updateCountdown();

setInterval(
    updateCountdown,
    1000
);


/* =====================================================
   SCROLL REVEAL
===================================================== */

function startReveal() {

    const elements =
        document.querySelectorAll(".reveal");


    const observer =
        new IntersectionObserver(

            function(entries) {

                entries.forEach(
                    function(entry) {

                        if (
                            entry.isIntersecting
                        ) {

                            entry.target
                                .classList
                                .add("show");

                        }

                    }
                );

            },

            {
                threshold: 0.12
            }

        );


    elements.forEach(
        function(element) {

            observer.observe(element);

        }
    );

}


/* =====================================================
   GOOGLE MAPS
===================================================== */

function openMap() {

    const url =
        "https://www.google.com/maps/search/?api=1&query=Garden+Aurora+Hall+Makassar";

    window.open(
        url,
        "_blank"
    );

}


/* =====================================================
   COPY REKENING
===================================================== */

function copyAccount() {

    const account =
        "1234567890";


    navigator.clipboard
        .writeText(account)
        .then(function() {

            alert(
                "Nomor rekening berhasil disalin."
            );

        })
        .catch(function() {

            alert(
                "Nomor rekening: " +
                account
            );

        });

}


/* =====================================================
   PESAN TAMU
===================================================== */

const messageForm =
    document.getElementById("messageForm");

const messagesContainer =
    document.getElementById("messages");


function loadMessages() {

    const saved =
        JSON.parse(
            localStorage.getItem(
                "weddingMessages"
            ) || "[]"
        );


    messagesContainer.innerHTML = "";


    saved.forEach(
        function(item) {

            addMessageToScreen(
                item.name,
                item.message
            );

        }
    );

}


function addMessageToScreen(
    name,
    message
) {

    const div =
        document.createElement("div");

    div.className =
        "message-item";


    const strong =
        document.createElement("strong");

    strong.innerText =
        name;


    const p =
        document.createElement("p");

    p.innerText =
        message;


    div.appendChild(strong);

    div.appendChild(p);

    messagesContainer
        .appendChild(div);

}


messageForm.addEventListener(
    "submit",
    function(event) {

        event.preventDefault();


        const name =
            document.getElementById(
                "guestName"
            ).value.trim();


        const message =
            document.getElementById(
                "guestMessage"
            ).value.trim();


        if (!name || !message) {
            return;
        }


        const saved =
            JSON.parse(
                localStorage.getItem(
                    "weddingMessages"
                ) || "[]"
            );


        saved.unshift({

            name: name,

            message: message

        });


        localStorage.setItem(
            "weddingMessages",
            JSON.stringify(saved)
        );


        addMessageToScreen(
            name,
            message
        );


        messageForm.reset();


        alert(
            "Terima kasih atas ucapan dan doanya ❤️"
        );

    }
);


loadMessages();


/* =====================================================
   SALJU
===================================================== */

const snowContainer =
    document.getElementById(
        "snow-container"
    );


function createSnow() {

    const snow =
        document.createElement("span");

    snow.className =
        "snowflake";

    snow.innerHTML =
        "•";


    const size =
        Math.random() * 7 + 3;

    snow.style.fontSize =
        size + "px";


    snow.style.left =
        Math.random() * 100 + "%";


    const duration =
        Math.random() * 8 + 7;

    snow.style.animationDuration =
        duration + "s";


    snow.style.animationDelay =
        Math.random() * 8 + "s";


    const wind =
        (Math.random() - 0.5) * 180;


    snow.style.setProperty(
        "--wind",
        wind + "px"
    );


    snow.style.opacity =
        Math.random() * .6 + .3;


    snowContainer.appendChild(
        snow
    );


    setTimeout(
        function() {

            snow.remove();

        },

        (duration + 8) * 1000

    );

}


/* SALJU AWAL */

for (
    let i = 0;
    i < 255;
    i++
) {

    createSnow();

}


/* TAMBAH SALJU */

setInterval(
    function() {

        createSnow();

    },
    200
);
    </script>


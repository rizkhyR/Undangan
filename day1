<!DOCTYPE html>
<html lang="id">
<head>

<meta charset="UTF-8">

<meta name="viewport"
content="width=device-width, initial-scale=1.0">

<title>Wedding Invitation</title>

<!-- GOOGLE FONT -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect"
      href="https://fonts.gstatic.com"
      crossorigin>

<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;500;600;700&family=Great+Vibes&family=Montserrat:wght@300;400;500;600&display=swap"
rel="stylesheet">


<style>

/* =====================================================
   GLOBAL
===================================================== */

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

html{
    scroll-behavior:smooth;
}

body{
    background:#e6d9ca;
    color:#50392d;
    font-family:'Montserrat',sans-serif;
    overflow-x:hidden;
}

:root{
    --ivory:#faf6ef;
    --cream:#f2e7d8;
    --paper:#fffdf9;

    --brown:#654537;
    --brown-dark:#432d23;
    --brown-light:#916c53;

    --gold:#b39163;
    --gold-light:#d2b58b;

    --text:#5d4a3e;
}


/* =====================================================
   COVER
===================================================== */

.cover{
    min-height:100vh;

    display:flex;
    justify-content:center;
    align-items:center;

    position:relative;

    padding:30px 15px;

    overflow:hidden;

    background:
    radial-gradient(
        circle at center,
        #fffefa 0%,
        #f6eee4 45%,
        #dfd0bf 100%
    );

    transition:
    opacity 1s ease,
    transform 1s ease;
}


/* cahaya */

.cover::before{
    content:"";

    position:absolute;

    width:450px;
    height:450px;

    background:rgba(255,255,255,.8);

    filter:blur(110px);

    border-radius:50%;

    left:50%;
    top:45%;

    transform:translate(-50%,-50%);
}


/* garis luar */

.cover-frame{
    position:absolute;

    inset:15px;

    border:1px solid rgba(101,69,55,.35);

    pointer-events:none;
}

.cover-frame::after{
    content:"";

    position:absolute;

    inset:8px;

    border:1px solid rgba(179,145,99,.35);
}


/* =====================================================
   ORNAMEN BESAR
===================================================== */

.corner{
    position:absolute;

    color:#765644;

    opacity:.35;

    font-family:'Cormorant Garamond',serif;

    font-size:120px;

    line-height:1;

    z-index:1;
}

.corner.one{
    top:-35px;
    left:-35px;

    transform:rotate(-25deg);
}

.corner.two{
    top:-35px;
    right:-35px;

    transform:rotate(25deg) scaleX(-1);
}

.corner.three{
    bottom:-35px;
    left:-35px;

    transform:rotate(155deg);
}

.corner.four{
    bottom:-35px;
    right:-35px;

    transform:rotate(-155deg) scaleX(-1);
}


/* =====================================================
   COVER CONTAINER
===================================================== */

.cover-container{
    width:100%;
    max-width:420px;

    position:relative;

    z-index:5;

    text-align:center;

    animation:coverEnter 1.4s ease;
}

@keyframes coverEnter{

    from{
        opacity:0;
        transform:
        translateY(50px)
        scale(.94);
    }

    to{
        opacity:1;
        transform:
        translateY(0)
        scale(1);
    }
}


/* =====================================================
   AMPLOP BELAKANG
===================================================== */

.envelope{
    position:relative;

    width:min(88vw,370px);

    height:500px;

    margin:auto;

    background:
    linear-gradient(
        145deg,
        #d8c2aa,
        #c6aa8e
    );

    box-shadow:
    0 30px 60px
    rgba(68,44,31,.23);

    transform:rotate(1deg);
}


/* lipatan kiri */

.envelope::before{
    content:"";

    position:absolute;

    inset:0;

    background:
    linear-gradient(
        140deg,
        transparent 49%,
        rgba(105,73,55,.18) 50%,
        transparent 51%
    );
}


/* lipatan kanan */

.envelope::after{
    content:"";

    position:absolute;

    inset:0;

    background:
    linear-gradient(
        40deg,
        transparent 49%,
        rgba(105,73,55,.15) 50%,
        transparent 51%
    );
}


/* =====================================================
   KARTU UNDANGAN
===================================================== */

.invitation-card{
    position:absolute;

    width:86%;

    height:88%;

    left:7%;
    top:6%;

    background:
    linear-gradient(
        145deg,
        #fffefa,
        #f5ece1
    );

    border:1px solid #b99a76;

    box-shadow:
    0 18px 35px
    rgba(64,42,30,.22);

    z-index:5;

    transform:rotate(-2deg);

    overflow:hidden;
}


/* frame */

.invitation-card::before{
    content:"";

    position:absolute;

    inset:13px;

    border:
    1px solid
    rgba(105,73,55,.65);
}

.invitation-card::after{
    content:"";

    position:absolute;

    inset:19px;

    border:
    1px solid
    rgba(179,145,99,.55);
}


/* =====================================================
   ORNAMEN KARTU
===================================================== */

.flower{
    position:absolute;

    font-size:65px;

    color:#795947;

    opacity:.6;

    z-index:2;
}

.flower.top-left{
    top:0;
    left:0;

    transform:rotate(-30deg);
}

.flower.top-right{
    top:0;
    right:0;

    transform:
    rotate(30deg)
    scaleX(-1);
}

.flower.bottom-left{
    bottom:0;
    left:0;

    transform:rotate(150deg);
}

.flower.bottom-right{
    bottom:0;
    right:0;

    transform:
    rotate(-150deg)
    scaleX(-1);
}


/* =====================================================
   ISI COVER
===================================================== */

.card-content{
    position:relative;

    z-index:10;

    height:100%;

    padding:
    45px 25px 25px;

    display:flex;

    align-items:center;

    flex-direction:column;

    text-align:center;
}


.small-title{
    font-size:8px;

    letter-spacing:5px;

    color:#765443;

    margin-top:5px;

    text-transform:uppercase;
}


.wedding-text{
    margin-top:28px;

    font-family:'Cormorant Garamond',serif;

    font-size:21px;

    letter-spacing:2px;

    color:#654537;
}


.cover-name{
    font-family:'Great Vibes',cursive;

    font-size:52px;

    color:#654537;

    line-height:.9;

    margin-top:8px;
}


.cover-and{
    font-family:'Cormorant Garamond',serif;

    font-size:28px;

    color:#b39163;

    margin:8px 0;
}


/* =====================================================
   LABEL TANGGAL
===================================================== */

.date-label{
    position:relative;

    width:115px;
    height:115px;

    border-radius:50%;

    background:
    #704b3b;

    border:
    4px double
    #d4b88c;

    display:flex;

    flex-direction:column;

    justify-content:center;

    align-items:center;

    color:white;

    margin-top:auto;

    box-shadow:
    0 10px 20px
    rgba(70,45,30,.2);
}


.date-label span:first-child{
    font-family:'Cormorant Garamond',serif;

    font-size:13px;

    letter-spacing:2px;
}


.date-label strong{
    font-family:'Great Vibes',cursive;

    font-size:31px;

    font-weight:400;
}


.date-label span:last-child{
    font-size:9px;

    letter-spacing:3px;
}


/* =====================================================
   WAX SEAL
===================================================== */

.seal{
    width:65px;
    height:65px;

    border-radius:50%;

    background:
    radial-gradient(
        circle,
        #9a6e51,
        #624031
    );

    border:
    3px double
    #d4b88c;

    color:#f9ead6;

    display:flex;

    align-items:center;

    justify-content:center;

    font-family:'Cormorant Garamond',serif;

    font-size:25px;

    margin-top:-12px;

    z-index:20;

    box-shadow:
    0 8px 20px
    rgba(70,40,25,.25);
}


/* =====================================================
   BOTTOM TEXT
===================================================== */

.save-date{
    margin-top:13px;

    font-size:7px;

    letter-spacing:4px;

    color:#916c53;
}


/* =====================================================
   OPEN BUTTON
===================================================== */

.open-button{
    position:relative;

    z-index:20;

    margin-top:28px;

    padding:15px 34px;

    border:1px solid #654537;

    background:#654537;

    color:#fffaf3;

    font-family:'Montserrat',sans-serif;

    font-size:9px;

    letter-spacing:3px;

    cursor:pointer;

    box-shadow:
    0 12px 25px
    rgba(68,44,31,.2);

    transition:.35s;
}

.open-button:hover{
    background:#8a624c;

    transform:
    translateY(-3px);
}


/* =====================================================
   INVITATION PAGE
===================================================== */

.invitation{
    display:none;

    background:#eee2d3;
}


.invitation.active{
    display:block;

    animation:
    pageIn 1.2s ease;
}


@keyframes pageIn{

    from{
        opacity:0;
        transform:translateY(40px);
    }

    to{
        opacity:1;
        transform:translateY(0);
    }
}


/* =====================================================
   HERO
===================================================== */

.hero{
    min-height:100vh;

    position:relative;

    display:flex;

    align-items:center;

    justify-content:center;

    text-align:center;

    padding:30px;

    overflow:hidden;

    background:
    linear-gradient(
        rgba(57,39,30,.35),
        rgba(57,39,30,.78)
    ),
    url("https://images.unsplash.com/photo-1519741497674-611481863552?auto=format&fit=crop&w=1600&q=90")
    center/cover;
}


/* frame hero */

.hero::before{
    content:"";

    position:absolute;

    inset:18px;

    border:
    1px solid
    rgba(255,255,255,.5);
}

.hero::after{
    content:"";

    position:absolute;

    inset:26px;

    border:
    1px solid
    rgba(218,188,145,.5);
}


.hero-content{
    position:relative;

    z-index:5;

    color:white;
}


.hero-small{
    font-size:9px;

    letter-spacing:6px;

    color:#ead5b7;

    margin-bottom:22px;
}


.hero h1{
    font-family:'Great Vibes',cursive;

    font-size:
    clamp(65px,19vw,110px);

    font-weight:400;

    line-height:.85;
}


.hero-and{
    font-family:'Cormorant Garamond',serif;

    font-size:34px;

    color:#d7b98d;

    margin:15px 0;
}


.hero-date{
    margin-top:35px;

    font-family:'Cormorant Garamond',serif;

    font-size:18px;

    letter-spacing:6px;

    color:#f4e5cf;
}


.hero-scroll{
    margin-top:55px;

    font-size:7px;

    letter-spacing:4px;

    color:#eee;

    animation:scrollDown 2s infinite;
}


@keyframes scrollDown{

    50%{
        transform:translateY(8px);
    }
}


/* =====================================================
   PAPER
===================================================== */

.paper{
    max-width:950px;

    margin:auto;

    background:#faf6ef;

    position:relative;

    overflow:hidden;
}


.paper::before{
    content:"";

    position:absolute;

    inset:18px;

    border:
    1px solid
    rgba(115,79,59,.22);

    pointer-events:none;
}


/* =====================================================
   ORNAMEN SECTION
===================================================== */

.paper-decoration{
    position:absolute;

    color:#8d6b54;

    opacity:.16;

    font-size:130px;

    z-index:0;
}

.paper-decoration.left{
    left:-55px;
    top:350px;

    transform:rotate(-30deg);
}

.paper-decoration.right{
    right:-55px;
    top:850px;

    transform:
    rotate(150deg)
    scaleX(-1);
}


/* =====================================================
   SECTION
===================================================== */

.section{
    position:relative;

    z-index:2;

    padding:
    90px 30px;

    text-align:center;
}


.section-label{
    font-size:8px;

    letter-spacing:5px;

    color:#98775e;

    margin-bottom:16px;
}


.section-title{
    font-family:'Great Vibes',cursive;

    font-size:52px;

    font-weight:400;

    color:#654537;
}


.section-title::after{
    content:"✦";

    display:block;

    font-family:Georgia,serif;

    font-size:13px;

    color:#b39163;

    margin-top:10px;
}


.section-text{
    max-width:650px;

    margin:
    25px auto 0;

    font-size:12px;

    line-height:2;

    color:#6b594d;
}


/* =====================================================
   BISMILLAH
===================================================== */

.bismillah{
    font-family:'Cormorant Garamond',serif;

    font-size:28px;

    color:#654537;

    margin-bottom:24px;
}


/* =====================================================
   MEMPELAI
===================================================== */

.couple-photos{
    display:flex;

    justify-content:center;

    align-items:center;

    gap:20px;

    margin-top:45px;

    flex-wrap:wrap;
}


.couple-photo{
    width:210px;
    height:270px;

    padding:7px;

    background:white;

    border:1px solid #c7aa88;

    box-shadow:
    0 18px 35px
    rgba(75,48,34,.15);
}


.couple-photo:nth-child(1){
    transform:rotate(-4deg);
}


.couple-photo:nth-child(2){
    transform:rotate(4deg);
}


.couple-photo img{
    width:100%;
    height:100%;

    object-fit:cover;
}


.couple-name{
    font-family:'Great Vibes',cursive;

    font-size:48px;

    color:#654537;

    margin-top:28px;
}


.parents{
    font-size:10px;

    line-height:2;

    color:#66564a;
}


.big-and{
    font-family:'Cormorant Garamond',serif;

    font-size:38px;

    color:#b39163;

    margin:13px;
}


/* =====================================================
   QUOTE
===================================================== */

.quote{
    max-width:700px;

    margin:auto;

    padding:50px 30px;

    background:
    linear-gradient(
        145deg,
        #f0e3d3,
        #f8f1e8
    );

    border-top:
    1px solid #c8ab88;

    border-bottom:
    1px solid #c8ab88;

    position:relative;
}


.quote::before,
.quote::after{
    font-family:Georgia,serif;

    font-size:60px;

    color:#b39163;

    position:absolute;

    opacity:.5;
}


.quote::before{
    content:"“";

    top:5px;
    left:20px;
}


.quote::after{
    content:"”";

    bottom:-30px;
    right:20px;
}


.quote p{
    font-family:'Cormorant Garamond',serif;

    font-size:24px;

    line-height:1.6;

    color:#654537;
}


/* =====================================================
   EVENT
===================================================== */

.event-wrapper{
    max-width:780px;

    margin:
    45px auto 0;

    display:grid;

    grid-template-columns:
    repeat(2,1fr);

    gap:20px;
}


.event-card{
    position:relative;

    padding:45px 20px;

    background:#fffdf9;

    border:
    1px solid #c8aa87;

    box-shadow:
    0 15px 35px
    rgba(70,45,30,.10);
}


.event-card::before{
    content:"";

    position:absolute;

    inset:8px;

    border:
    1px solid
    rgba(179,145,99,.35);

    pointer-events:none;
}


.event-icon{
    font-size:28px;

    color:#9a7355;

    margin-bottom:12px;
}


.event-card h3{
    font-family:'Great Vibes',cursive;

    font-size:42px;

    font-weight:400;

    color:#654537;

    margin-bottom:15px;
}


.event-card p{
    font-size:10px;

    line-height:2;

    color:#68574c;
}


/* =====================================================
   COUNTDOWN
===================================================== */

.countdown{
    max-width:700px;

    margin:
    45px auto 0;

    display:grid;

    grid-template-columns:
    repeat(4,1fr);

    gap:8px;
}


.count-box{
    padding:25px 5px;

    background:#654537;

    color:white;

    position:relative;
}


.count-box strong{
    display:block;

    font-family:'Cormorant Garamond',serif;

    font-size:38px;

    font-weight:400;

    color:#e7cda8;
}


.count-box span{
    font-size:7px;

    letter-spacing:2px;
}


/* =====================================================
   KALENDER
===================================================== */

.calendar{
    max-width:620px;

    margin:
    45px auto 0;

    padding:35px 25px;

    background:#fffdf9;

    border:
    1px solid #c8aa87;

    box-shadow:
    0 15px 35px
    rgba(70,45,30,.08);
}


.calendar-month{
    font-family:'Great Vibes',cursive;

    font-size:48px;

    color:#654537;

    margin-bottom:25px;
}


.calendar-grid{
    display:grid;

    grid-template-columns:
    repeat(7,1fr);

    gap:5px;

    font-size:10px;
}


.week{
    font-weight:600;

    color:#775745;

    padding:8px 0;
}


.day{
    padding:9px 0;

    color:#66564a;

    min-height:30px;
}


.special{
    width:32px;
    height:32px;

    margin:auto;

    border-radius:50%;

    background:#654537;

    color:white;

    display:flex;

    align-items:center;

    justify-content:center;

    box-shadow:
    0 5px 10px
    rgba(60,40,30,.2);
}


/* =====================================================
   LOCATION
===================================================== */

.location-card{
    max-width:750px;

    margin:
    45px auto 0;

    position:relative;

    padding:50px 25px;

    background:
    linear-gradient(
        145deg,
        #68493a,
        #4b3328
    );

    color:white;

    box-shadow:
    0 20px 40px
    rgba(65,42,30,.2);
}


.location-card::before{
    content:"";

    position:absolute;

    inset:10px;

    border:
    1px solid
    rgba(221,193,151,.55);

    pointer-events:none;
}


.location-icon{
    font-size:32px;

    color:#d7b98c;

    margin-bottom:12px;
}


.location-card h3{
    font-family:'Great Vibes',cursive;

    font-size:43px;

    font-weight:400;

    color:#ead1ac;

    margin-bottom:15px;
}


.location-card p{
    font-size:10px;

    line-height:2;

    color:#f0e7dc;

    margin-bottom:28px;
}


.map-button{
    display:inline-block;

    text-decoration:none;

    padding:13px 25px;

    border:1px solid #d5b78d;

    color:white;

    font-size:8px;

    letter-spacing:2px;

    transition:.3s;
}


.map-button:hover{
    background:#d5b78d;

    color:#4d3428;
}


/* =====================================================
   GALERI 2 FOTO
===================================================== */

.gallery{
    max-width:750px;

    margin:
    45px auto 0;

    display:grid;

    grid-template-columns:
    repeat(2,1fr);

    gap:18px;
}


.gallery-photo{
    height:360px;

    background:white;

    padding:8px;

    border:1px solid #c6a47f;

    box-shadow:
    0 15px 30px
    rgba(70,45,30,.12);
}


.gallery-photo:nth-child(1){
    transform:rotate(-2deg);
}


.gallery-photo:nth-child(2){
    transform:rotate(2deg);
}


.gallery-photo img{
    width:100%;
    height:100%;

    object-fit:cover;
}


/* =====================================================
   CLOSING
===================================================== */

.closing{
    min-height:600px;

    display:flex;

    align-items:center;

    justify-content:center;

    text-align:center;

    padding:30px;

    color:white;

    background:
    linear-gradient(
        rgba(63,43,33,.58),
        rgba(63,43,33,.86)
    ),
    url("https://images.unsplash.com/photo-1511285560929-80b456fea0bc?auto=format&fit=crop&w=1600&q=90")
    center/cover;

    position:relative;
}


.closing::before{
    content:"";

    position:absolute;

    inset:20px;

    border:
    1px solid
    rgba(239,215,180,.55);
}


.closing-content{
    position:relative;

    z-index:2;
}


.closing-small{
    font-size:8px;

    letter-spacing:5px;

    color:#e5c99f;
}


.closing h2{
    font-family:'Great Vibes',cursive;

    font-size:65px;

    font-weight:400;

    margin:20px 0;
}


.closing p{
    max-width:550px;

    font-size:11px;

    line-height:2;

    color:#f5ede3;
}


.closing-date{
    margin-top:30px;

    font-family:'Cormorant Garamond',serif;

    font-size:20px;

    letter-spacing:5px;

    color:#e2c49b;
}


/* =====================================================
   FOOTER
===================================================== */

.footer{
    padding:25px;

    background:#38271f;

    color:#cbb9a6;

    text-align:center;

    font-size:7px;

    letter-spacing:3px;
}


/* =====================================================
   TOP BUTTON
===================================================== */

.top-button{
    position:fixed;

    right:18px;
    bottom:18px;

    width:45px;
    height:45px;

    border-radius:50%;

    border:1px solid #d1b187;

    background:#654537;

    color:white;

    cursor:pointer;

    opacity:0;

    pointer-events:none;

    transition:.3s;

    z-index:100;
}


.top-button.show{
    opacity:1;

    pointer-events:auto;
}


/* =====================================================
   MOBILE
===================================================== */

@media(max-width:600px){

    .envelope{
        height:490px;
    }

    .invitation-card{
        height:88%;
    }

    .card-content{
        padding:
        40px 22px 20px;
    }

    .cover-name{
        font-size:49px;
    }

    .date-label{
        width:105px;
        height:105px;
    }

    .couple-photo{
        width:150px;
        height:205px;
    }

    .event-wrapper{
        grid-template-columns:1fr;
    }

    .countdown{
        grid-template-columns:
        repeat(2,1fr);
    }

    .gallery{
        grid-template-columns:1fr;
        max-width:420px;
    }

    .gallery-photo{
